# Real backend is the default. Mock events are available only in development.
VITE_USE_MOCK_DATA=false
API_PROXY_TARGET=http://127.0.0.1:8000

# Server-only provider configuration. Put real values in .env.local, never VITE_* variables.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
