      "config": {
        "profile": "default",
        "hotdata": {
          "apikey": "${HOTDATA_API_KEY}",
          "workspace_id": "${HOTDATA_WORKSPACE_ID}",
          "database_id": "${HOTDATA_DB_MEDICAL}",
          "allow_execute": true,
          "allow_destructive_load": false,
          "db_description": "Tables in default.main: facilities, zones, resources. All rows are simulated exercise data. Domain: medical and sheltering.",
          "max_execute_rows": 2000,
          "job_timeout_secs": 60,
          "max_attempts": 2
        },
        "hotdata.apikey": "${HOTDATA_API_KEY}",
        "hotdata.workspace_id": "${HOTDATA_WORKSPACE_ID}",
        "hotdata.database_id": "${HOTDATA_DB_MEDICAL}",
        "hotdata.allow_execute": true,
        "hotdata.allow_destructive_load": false,
        "hotdata.db_description": "Tables in default.main: facilities, zones, resources. All rows are simulated exercise data. Domain: medical and sheltering.",
        "hotdata.max_execute_rows": 2000,
        "hotdata.job_timeout_secs": 60,
        "hotdata.max_attempts": 2,
        "parameters": {}
      },
      "control": [
        {
          "classType": "tool",
          "from": "medical"
        }
      ]
