    {
      "id": "infrastructure",
      "provider": "agent_rocketride",
      "name": "INFRASTRUCTURE + UTILITIES",
      "config": {
        "agent_description": "INFRASTRUCTURE + UTILITIES specialist for infrastructure and utilities",
        "instructions": [
          "You are one specialist inside an emergency incident-command system. Your data lives in your OWN database; query it with SQL before answering. Tables are addressed as default.main.<table>. The SQL surface is READ-ONLY. All data is SIMULATED for an exercise. Answer with ONE JSON object and nothing else: no prose, no code fences. Be terse: short strings, no restating the question, at most 5 items per list. Cite the row ids you relied on.",
          "Own power, water, communications, critical infrastructure, utility failures and restoration priorities.",
          "Follow the depends_on column to find cascading failures. Flag assets on backup power with a short restore_eta_hours, and any facility whose backup_hours is low.",
          "Return exactly this JSON shape: {\"outages\":[{\"asset_id\":\"\",\"status\":\"\",\"customers_affected\":0,\"impact\":\"\"}],\"cascade_risks\":[{\"asset_id\":\"\",\"depends_on\":\"\",\"consequence\":\"\"}],\"restoration_priority\":[{\"asset_id\":\"\",\"rank\":0,\"why\":\"\"}],\"power_needs\":[{\"facility_id\":\"\",\"kw_needed\":0,\"hours_remaining\":0}],\"priority_actions\":[{\"action\":\"\",\"why\":\"\"}],\"cited_ids\":[\"\"],\"confidence\":\"high|medium|low\"}"
        ],
        "max_waves": 3,
        "agent_rocketride": {
          "profile": "default"
        },
        "parameters": {}
      },
      "input": [
        {
          "lane": "answers",
          "from": "medical"
        }
      ]
    },
    {
      "id": "llm_infrastructure",
      "provider": "llm_anthropic",
      "name": "Claude (claude-haiku-4-5)",
      "config": {
        "profile": "claude-haiku-4-5",
        "claude-haiku-4-5": {
          "apikey": "${ANTHROPIC_API_KEY}"
        },
