        "hotdata": {
          "apikey": "${HOTDATA_API_KEY}",
          "workspace_id": "${HOTDATA_WORKSPACE_ID}",
          "database_id": "${HOTDATA_DB_INFRASTRUCTURE}",
          "allow_execute": true,
