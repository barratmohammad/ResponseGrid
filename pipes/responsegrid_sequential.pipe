          "from": "logistics"
        }
      ]
    },
    {
      "id": "hd_logistics",
      "provider": "db_hotdata",
      "name": "Hotdata logistics",
      "config": {
        "profile": "default",
        "hotdata": {
          "apikey": "${HOTDATA_API_KEY}",
          "workspace_id": "${HOTDATA_WORKSPACE_ID}",
          "database_id": "${HOTDATA_DB_LOGISTICS}",
          "allow_execute": true,
