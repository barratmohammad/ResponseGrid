        "hotdata.database_id": "${HOTDATA_DB_LOGISTICS}",
        "hotdata.allow_execute": true,
        "hotdata.allow_destructive_load": false,
        "hotdata.db_description": "Tables in default.main: resources, hazards, facilities, utilities. All rows are simulated exercise data. Domain: logistics and resources.",
        "hotdata.max_execute_rows": 2000,
        "hotdata.job_timeout_secs": 60,
        "hotdata.max_attempts": 2,
